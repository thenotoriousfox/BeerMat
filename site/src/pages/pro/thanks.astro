---
import Page from '../../layouts/Page.astro';
---
<Page title="Welcome to BeerMat Pro">
	<section class="wrap max-w-2xl py-16 text-center">
		<p class="font-display text-7xl text-amber neon">✓</p>
		<h1 class="text-4xl">Welcome to BeerMat Pro</h1>
		<p class="text-lg text-muted">Thanks! We’ve emailed you to set up your BeerMat account. It can take a minute to arrive; check your spam folder if not.</p>
		<ol class="card mx-auto mt-8 max-w-lg space-y-2 text-left text-muted">
			<li><strong class="text-white">1.</strong> Choose your password from the email.</li>
			<li><strong class="text-white">2.</strong> <a href="/download">Download BeerMat</a> for the quiz laptop.</li>
			<li><strong class="text-white">3.</strong> Sign in on the desk’s <strong>Venue</strong> tab and add your quiz nights.</li>
		</ol>
		<p class="mt-6 text-sm text-muted">Your pub goes on the map once we’ve checked it, usually within a day.</p>
	</section>
</Page>
