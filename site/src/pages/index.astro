---
import Page from '../layouts/Page.astro';
import Shot from '../components/Shot.astro';
import {ONLINE, PRICE} from '../consts';

// Screenshots are of the real app running a demo quiz (scripts/site-screenshots.mjs makes them again).
const TV = {width: 1600, height: 900}, DESK = {width: 1600, height: 1000}, PHONE = {width: 780, height: 1688};
const screens = [
	{n: '1', where: 'On the telly', title: 'The quiz on the big screen', text: 'The question, the clock and a QR code to join, big enough for the back of the room. A second screen, a projector or the pub’s TV.',
		shot: {src: '/shots/tv-question.webp', alt: 'The TV during a question: four coloured answers and the time left', ...TV, retina: true, sizes: '(min-width: 1024px) 420px, 100vw'}},
	{n: '2', where: 'On every table', title: 'Teams play on a phone', text: 'Heads together round one phone, then a tap to answer. They play in the browser: no app, no account, no sign-up.',
		shot: {src: '/shots/phone-choice.webp', alt: 'A team’s phone during a question, with four answers to tap', ...PHONE}, tall: true},
	{n: '3', where: 'Behind the bar', title: 'You run it from the desk', text: 'The next question is one big button. Answers are marked as they arrive, and you see which teams are in.',
		shot: {src: '/shots/desk.webp', alt: 'The quizmaster’s desk: the live question, which teams have answered, and what’s up next', ...DESK, retina: true, sizes: '(min-width: 1024px) 420px, 100vw'}},
];
const formatShots = [
	['phone-wordsnake', 'Word trail', 'Trace the answer through a grid of letters'],
	['phone-pinpoint', 'Pinpoint', 'Tap the spot on the picture'],
	['phone-tiles', 'Letter tiles', 'Rebuild the answer from the tiles'],
	['phone-sequence', 'Sequence', 'Put them in the right order'],
	['phone-buzzer', 'Buzz-in', 'First to buzz answers out loud'],
	['phone-bingo', 'Bingo', 'A ticket on every phone; shout BINGO!'],
];
const formats = ['Multiple choice', 'Tick all that apply', 'Letter keypad', 'Numbers', 'Nearest wins', 'Typed answers', 'Picture rounds', 'Audio rounds',
	'Votes', 'Sequence', 'Pinpoint', 'Word trail', 'Letter tiles', 'Buzz-in', 'Number bingo', 'Music bingo', 'Sound clips', 'Answer sheets'];
// Small line icons for the reasons list.
const icons = {
	offline: 'M3 8.5a13 13 0 0 1 18 0M6.5 12a8 8 0 0 1 11 0M10 15.5a3 3 0 0 1 4 0M12 19h.01',
	marking: 'M4 12.5l5 5L20 6.5',
	room: 'M4 5h16v11H4zM9 20h6M12 16v4',
	saved: 'M5 4h11l3 3v13H5zM8 4v5h8V4M8 20v-6h8v6',
	map: 'M12 21s-6-5.5-6-11a6 6 0 0 1 12 0c0 5.5-6 11-6 11zM12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z',
	buzzer: 'M7 15a5 5 0 0 1 10 0M5 15h14v3H5zM12 5v3M7.5 6.5l1.5 2.5M16.5 6.5 15 9',
};
const reasons = [
	['offline', 'No internet needed', 'The laptop makes its own quiz Wi-Fi, or uses the pub’s. If the internet goes down, the quiz doesn’t.'],
	['marking', 'The desk does the marking', 'Typed answers are marked as they arrive, with alternative spellings. Overrule anything with one tap.'],
	['room', 'Built for the room', 'A big Next button, a checklist before you start, buzzers with silly sounds, and a leaderboard reveal.'],
	['saved', 'Nothing lost', 'Everything saves as you go. If the laptop restarts, the quiz carries on where it was, and teams keep their place.'],
	['map', 'Your pub on the map', 'With BeerMat Pro, your pub and its quiz nights are on the BeerMat map, in the app and on this website, so players can find you.'],
	['buzzer', 'Libraries of quizzes, buzzers and themes', 'Ready-made quizzes, buzzer sounds for every team, and themes that dress up the TV and phones (Halloween among them). With BeerMat Pro, download any of them from the BeerMat libraries, and share your own.'],
] as const;
---
<Page>
	<!-- Hosting first: what BeerMat is, and trying it. Players have their own route, set apart. -->
	<section class="wrap grid items-center gap-12 pt-6 pb-20 lg:grid-cols-[1fr_1.1fr] lg:pt-12">
		<div>
			<p class="eyebrow">Pub quiz software for hosts</p>
			<h1 class="text-4xl text-balance sm:text-5xl lg:text-6xl">Run the whole pub quiz from <span class="text-amber neon">one laptop</span></h1>
			<p class="mt-5 max-w-xl text-lg text-muted">The desk for the quizmaster, the quiz on the TV, and every team playing on their phones. No paper, no marking by hand, and it works with or without internet.</p>
			<div class="mt-8 flex flex-wrap gap-3">
				<a href="/download" class="btn btn-primary">Download free</a>
				<a href="#how" class="btn btn-ghost">See how it works</a>
			</div>
			<p class="mt-4 text-sm text-muted">Create for free. Go Pro to host. Players never pay.</p>
			<p class="mt-6 text-sm text-muted">Playing, not hosting? <a href="/find" class="font-semibold">Find a quiz near you →</a></p>
		</div>
		<div class="relative pb-10 sm:pb-14 lg:pb-0">
			<Shot src="/shots/tv-question.webp" alt="The quiz on the TV: the question, four coloured answers and the time left" {...TV} retina sizes="(min-width: 1024px) 560px, 100vw" loading="eager" class="shadow-2xl shadow-pink/20" />
			<div class="absolute -bottom-4 right-3 w-[20%] max-w-[8rem] sm:right-6 lg:-bottom-16 lg:-right-6">
				<Shot src="/shots/phone-choice.webp" alt="A team answering the same question on a phone" {...PHONE} loading="eager" class="!rounded-2xl border-white/30 shadow-2xl" />
			</div>
		</div>
	</section>

	<!-- How much BeerMat is used, from BeerMat Online (/v1/stats); left out when it can't be reached. -->
	<section id="counter" class="wrap pb-14" hidden>
		<dl class="flex flex-wrap justify-center gap-x-16 gap-y-6 text-center">
			<div><dt class="eyebrow">Quizzes run</dt><dd id="quizCount" class="text-4xl font-semibold text-amber sm:text-5xl"></dd></div>
			<div><dt class="eyebrow">Venues</dt><dd id="venueCount" class="text-4xl font-semibold text-amber sm:text-5xl"></dd></div>
		</dl>
	</section>
	<script is:inline type="application/json" id="online" set:html={JSON.stringify(ONLINE)}></script>

	<!-- The night itself: what the room sees, what teams do, what you do. -->
	<section id="how" class="scroll-mt-6 border-y border-white/10 bg-white/[.025] py-20">
		<div class="wrap">
			<p class="eyebrow">How it works</p>
			<h2 class="max-w-3xl text-3xl text-balance sm:text-4xl">A quiz night on three screens, from one laptop</h2>
			<p class="max-w-2xl text-muted">Open BeerMat on the laptop, put the quiz on the TV, and teams join by scanning the code. Everyone’s looking at something different.</p>
			<ol class="mt-10 grid gap-10 lg:grid-cols-[1fr_.5fr_1fr] lg:grid-rows-[auto_auto] lg:gap-x-8 lg:gap-y-0">
				{screens.map(s => (
					<li class="list-none lg:row-span-2 lg:grid lg:grid-rows-subgrid">
						<div class:list={['lg:self-end', s.tall && 'mx-auto max-w-[13rem] lg:max-w-none']}>
							<Shot {...s.shot} />
						</div>
						<div>
							<p class="eyebrow mt-5 flex items-center gap-2"><span class="grid h-6 w-6 place-items-center rounded-full bg-amber text-xs text-night">{s.n}</span>{s.where}</p>
							<h3 class="text-xl">{s.title}</h3>
							<p class="mb-0 text-muted">{s.text}</p>
						</div>
					</li>
				))}
			</ol>
		</div>
	</section>

	<!-- The reveal: the moment the room is waiting for. -->
	<section class="wrap grid items-center gap-12 py-20 lg:grid-cols-[.9fr_1.1fr]">
		<div>
			<p class="eyebrow">The big reveal</p>
			<h2 class="text-3xl text-balance sm:text-4xl">The groan, the cheer, the leaderboard</h2>
			<ul class="mt-6 space-y-4">
				<li class="flex gap-3"><svg class="tick" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.marking} /></svg><span>The answer goes up on the TV after a drum roll, with how the room voted.</span></li>
				<li class="flex gap-3"><svg class="tick" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.marking} /></svg><span>The fastest right answers get a shout-out, and a speed bonus if you want one.</span></li>
				<li class="flex gap-3"><svg class="tick" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.marking} /></svg><span>At the end of a round, the scores go up one place at a time, from the bottom.</span></li>
			</ul>
		</div>
		<div class="grid grid-cols-6 items-end gap-4">
			<div class="col-span-6 sm:col-span-4"><Shot src="/shots/tv-reveal.webp" alt="The answer revealed on the TV, with how many teams picked each answer and the fastest teams" {...TV} retina sizes="(min-width: 640px) 460px, 100vw" /></div>
			<div class="col-span-6 sm:col-span-4 sm:col-start-3 sm:-mt-10"><Shot src="/shots/tv-leaderboard.webp" alt="The leaderboard on the TV" {...TV} retina sizes="(min-width: 640px) 460px, 100vw" /></div>
		</div>
	</section>

	<!-- Round formats: real phone screens, then the full list. -->
	<section id="formats" class="scroll-mt-6 border-y border-white/10 bg-white/[.025] py-20">
		<div class="wrap">
			<p class="eyebrow">Round formats</p>
			<h2 class="text-3xl text-balance sm:text-4xl">More than questions and answers</h2>
			<p class="max-w-2xl text-muted">Every format plays on the phones teams already have. Here are a few, as teams see them.</p>
			<ul class="format-gallery mt-10">
				{formatShots.map(([file, name, text]) => (
					<li class="format-item">
						<div class="format-shot"><Shot src={`/shots/${file}.webp`} alt={`${name} on a team’s phone: ${text.toLowerCase()}`} {...PHONE} /></div>
						<div class="format-caption">
							<h3 class="text-lg">{name}</h3>
							<p class="mb-0 text-muted">{text}</p>
						</div>
					</li>
				))}
			</ul>
			<h3 class="mt-12 text-lg">All {formats.length} formats</h3>
			<ul class="mt-3 flex flex-wrap gap-2">
				{formats.map(f => <li class="chip list-none">{f}</li>)}
			</ul>
			<p class="mt-4 text-sm text-muted">Plus Risk It, fastest-finger bonuses, secret rounds and tie-breakers.</p>
		</div>
	</section>

	<!-- Why BeerMat: a list rather than another grid of cards. -->
	<section class="wrap grid gap-12 py-20 lg:grid-cols-[.8fr_1.2fr]">
		<div>
			<p class="eyebrow">Why BeerMat</p>
			<h2 class="text-3xl text-balance sm:text-4xl">Made for a Tuesday night in a busy pub</h2>
			<p class="text-muted">For the things that go wrong on the night: patchy Wi-Fi, a laptop that restarts, a room that can’t hear the question.</p>
		</div>
		<ul class="grid gap-x-10 gap-y-8 sm:grid-cols-2">
			{reasons.map(([icon, title, text]) => (
				<li class="flex list-none gap-4">
					<span class="grid h-11 w-11 flex-none place-items-center rounded-xl border border-amber/30 bg-amber/10 text-amber">
						<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[icon]} /></svg>
					</span>
					<div><h3 class="text-lg">{title}</h3><p class="mb-0 text-muted">{text}</p></div>
				</li>
			))}
		</ul>
	</section>

	<!-- The Library: quizzes, buzzers and themes from BeerMat and other pubs. -->
	<section class="wrap grid items-center gap-12 py-20 lg:grid-cols-[.8fr_1.2fr]">
		<div>
			<p class="eyebrow">The Library</p>
			<h2 class="text-3xl text-balance sm:text-4xl">No time to write a quiz this week?</h2>
			<p class="text-muted">Library, on the desk’s left rail, holds ready-made quizzes, buzzer sounds and themes from BeerMat and other BeerMat pubs. Browse it on any plan; with BeerMat Pro, download what you like and share your own.</p>
			<ul class="mt-6 space-y-4">
				<li class="flex gap-3"><svg class="tick" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.marking} /></svg><span><strong class="text-cream">Quizzes:</strong> see each one’s rounds and formats, then download and load it in one click, pictures and sounds included. The questions stay a surprise until you do.</span></li>
				<li class="flex gap-3"><svg class="tick" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.marking} /></svg><span><strong class="text-cream">Buzzers:</strong> short sounds for every team to pick from, shared by pubs.</span></li>
				<li class="flex gap-3"><svg class="tick" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.marking} /></svg><span><strong class="text-cream">Themes:</strong> dress the TV and the teams’ phones for the night, from Halloween to your pub’s own colours.</span></li>
				<li class="flex gap-3"><svg class="tick" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.marking} /></svg><span>Every quiz and theme is checked by BeerMat before other pubs see it.</span></li>
			</ul>
		</div>
		<Shot src="/shots/library.webp" alt="The Library on the quizmaster’s desk: ready-made quizzes with their rounds and formats, and a Download and load button for each" {...DESK} retina sizes="(min-width: 1024px) 640px, 100vw" />
	</section>

		<!-- Rehearsal: what Free does, so nobody's first quiz night is their first go. -->
	<section class="wrap py-20">
		<div class="card grid gap-10 !p-8 lg:grid-cols-[.9fr_1.1fr] lg:!p-10">
			<div>
				<p class="eyebrow">Free, with no limits</p>
				<h2 class="text-3xl text-balance sm:text-4xl">Rehearse the whole quiz before the room fills</h2>
				<p class="mb-0 text-muted">Build your quiz, then run it start to finish with simulated teams answering on the real quiz engine. Every format, every timer, the marking, the buzzers and the leaderboard, on the TV.</p>
			</div>
			<ul class="grid gap-5 sm:grid-cols-2">
				<li class="list-none"><h3 class="text-lg">Simulated teams</h3><p class="mb-0 text-muted">Up to thirty, right or wrong as often as you like, answering by themselves or when you tell them.</p></li>
				<li class="list-none"><h3 class="text-lg">Test the Wi-Fi with real phones</h3><p class="mb-0 text-muted">Scan the code with your own phones: they connect and show “Connection successful”, but can’t play.</p></li>
				<li class="list-none"><h3 class="text-lg">Try what goes wrong</h3><p class="mb-0 text-muted">Late answers, double taps, teams dropping out and coming back, buzzer races.</p></li>
				<li class="list-none"><h3 class="text-lg">A preflight check</h3><p class="mb-0 text-muted">Missing pictures, a full disk, the Wi-Fi and the network, checked in plain English.</p></li>
			</ul>
		</div>
	</section>

	<section id="pricing" class="scroll-mt-6 border-t border-white/10 py-20">
		<div class="wrap">
			<p class="eyebrow">Pricing</p>
			<h2 class="text-3xl sm:text-4xl">Create for free. Go Pro to host.</h2>
			<p class="max-w-2xl text-muted">Build and rehearse your whole quiz for nothing, phones and TV included. One simple price for your venue when real teams play: no per-night credits and no per-player charges. Players always play free.</p>
			<div class="mt-10 grid gap-6 md:grid-cols-2">
				<div class="card flex flex-col !p-7">
					<h3 class="text-2xl">BeerMat Free</h3>
					<p class="mb-1 font-display text-4xl font-bold text-white">£0</p>
					<p class="text-muted">Create, prepare and rehearse.</p>
					<ul class="mb-5 space-y-3">
						{['Unlimited quizzes, questions and rounds', 'Every round format', 'Rehearsals with simulated teams and real scoring', 'The TV and projector, to test the show', 'Real phones join to test the Wi-Fi and the QR code'].map(item => (
							<li class="flex gap-3"><svg class="tick" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.marking} /></svg>{item}</li>
						))}
					</ul>
					<p class="mb-8 rounded-xl border border-white/15 bg-white/[.04] px-4 py-3 text-sm"><strong class="text-cream">Not included:</strong> live quizzes with real teams playing. Phones can connect in a rehearsal, but can’t play.</p>
					<a href="/download" class="btn btn-ghost mt-auto w-full">Download free</a>
				</div>
				<div class="card relative flex flex-col border-amber/60 !p-7 shadow-2xl shadow-amber/10">
					<span class="absolute -top-3 right-6 rounded-full bg-pink px-3 py-1 text-xs font-bold text-white">For quiz nights</span>
					<h3 class="text-2xl">BeerMat Pro</h3>
					<p class="mb-1 font-display text-4xl font-bold text-amber">{PRICE.monthly}<span class="text-lg text-muted"> a month</span></p>
					<p class="text-muted">or {PRICE.yearly} a year (two months free)</p>
					<ul class="mb-8 space-y-3">
						{['Everything in Free', 'Host live quizzes: real teams, real answers and buzzers', 'Live scoring and leaderboards, as many teams as the room holds', 'Your pub and quiz nights on the BeerMat map', 'The quiz library: ready-made quizzes to download and run', 'The shared buzzer library', 'The theme library: Halloween and more looks for the TV and phones', 'Help by email when you need it', 'Works offline once activated; cancel any time from the desk'].map(item => (
							<li class="flex gap-3"><svg class="tick" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.marking} /></svg>{item}</li>
						))}
					</ul>
					<a href="/pro" class="btn btn-primary mt-auto w-full">Get BeerMat Pro</a>
				</div>
			</div>
		</div>
	</section>

	<section class="wrap pb-8">
		<div class="card flex flex-col items-start gap-6 !p-8 md:flex-row md:items-center md:justify-between">
			<div>
				<p class="eyebrow">For players</p>
				<h2 class="text-2xl sm:text-3xl">Playing, not hosting?</h2>
				<p class="mb-0 text-muted">Find a quiz near you on the map, or get the BeerMat app to keep your results and earn badges.</p>
			</div>
			<div class="flex shrink-0 flex-wrap gap-3">
				<a href="/find" class="btn btn-ghost">Find a quiz</a>
				<a href="/players" class="btn btn-primary">For players</a>
			</div>
		</div>
	</section>
</Page>

<script>
	// The counter: live quizzes finished on BeerMat laptops (each counted anonymously, unless the venue switched it off)
	// and venues using BeerMat.
	const online = JSON.parse(document.getElementById('online')!.textContent!) as string;
	fetch(online + '/v1/stats', {signal: AbortSignal.timeout(8000)}).then(r => r.ok ? r.json() : Promise.reject())
		.then(({quizzes, venues}: {quizzes: number; venues: number}) => {
			if (!quizzes && !venues) return;
			document.getElementById('quizCount')!.textContent = quizzes.toLocaleString('en-GB');
			document.getElementById('venueCount')!.textContent = venues.toLocaleString('en-GB');
			document.getElementById('counter')!.hidden = false;
		}).catch(() => {});
</script>
