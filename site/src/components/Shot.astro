---
// A product screenshot that opens full size in the page's viewer (Lightbox.astro). Keeps its proportions at any size.
interface Props {src: string; alt: string; width: number; height: number; class?: string; imgClass?: string; loading?: 'lazy' | 'eager';}
const {src, alt, width, height, class: className = '', imgClass = '', loading = 'lazy'} = Astro.props;
---
<button type="button" class:list={['shot group', className]} data-shot={src} data-caption={alt} data-width={width} data-height={height} aria-label={`Enlarge: ${alt}`}>
	<img src={src} alt={alt} width={width} height={height} loading={loading} decoding="async" class:list={['block h-auto w-full', imgClass]} />
	<span class="shot-zoom" aria-hidden="true">
		<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5 21 21M10.5 7.5v6M7.5 10.5h6" /></svg>
	</span>
</button>
